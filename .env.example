# Copy to .env (gitignored) and fill in. Never commit real keys.

# ElevenLabs — audio generation (scripts/generate-word-audio.js).
# elevenlabs.io → profile → API Keys → Create; starts with sk_.
ELEVENLABS_API_KEY=

# Cloudflare — deploy to the "eng-pwa" Pages project via wrangler.
# dash.cloudflare.com → My Profile → API Tokens; needs Cloudflare Pages · Edit.
CLOUDFLARE_API_TOKEN=
